    "com.anthropic.claude-code": {
      "pluginManifest": ".claude-plugin/plugin.json"
    },
    "com.openai.codex": {
      "pluginManifest": ".codex-plugin/plugin.json"
    },
    "com.cursor": {
      "pluginManifest": ".cursor-plugin/plugin.json"
    },
    "ai.xai.grok-build": {
      "pluginManifest": ".grok-plugin/plugin.json"
    }

    "url": "https://github.com/RichardHightower"
  },
  "homepage": "https://github.com/SpillwaveSolutions/document-specialist-skill",
  "repository": "https://github.com/SpillwaveSolutions/document-specialist-skill",
  "license": "MIT",
  "keywords": [
    "documentation",
    "sdd",
    "arc42",
    "architecture",
    "design-doc",
    "srs",
    "prd",
    "mermaid",
    "plantuml",
    "ste100",
    "google-docs-style",
    "claude-code",
    "grok-build",
    "codex",
    "cursor",
    "agent-plugins",
    "wiki-ticket-sdd"
